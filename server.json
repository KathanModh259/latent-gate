{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.KathanModh259/latent-gate",
  "title": "LatentGate",
  "description": "Read large logs, JSON and docs in a fraction of the tokens. Offline, fact-preserving optimizer.",
  "version": "1.3.1",
  "repository": {
    "url": "https://github.com/KathanModh259/latent-gate",
    "source": "github"
  },
  "websiteUrl": "https://github.com/KathanModh259/latent-gate#use-it-in-claude",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "latent-gate",
      "version": "1.3.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=1.0,<2"
        },
        {
          "type": "named",
          "name": "--with",
          "value": "tiktoken>=0.7.0"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
